{
  "version": 1,
  "projects": {
    "randomizer": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "index": "src/index.html",
            "styles": [
              "src/styles.css",
              "src/theme.css"
            ],
            "outputPath": "dist/randomizer",
            "baseHref": "./",
            "assets": [
              {
                "glob": "**/*",
                "input": "assets",
                "output": "assets"
              }
            ]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "randomizer:build"
          }
        }
      }
    }
  }
}
