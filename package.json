{
  "name": "oblivion-random-character",
  "version": "2.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "desktop": "npm run build && electron .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "package": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "typescript": "~6.0.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.noahthacker.oblivionrandomizer",
    "productName": "Oblivion Remastered: Random Character Generator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        "portable"
      ],
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Oblivion-Random-Character-${version}.exe"
    },
    "executableName": "Oblivion Remastered Random Character Generator",
    "compression": "normal"
  },
  "productName": "Oblivion Remastered: Random Character Generator",
  "description": "An offline character generator and challenge journal for Oblivion Remastered",
  "author": "Noah Thacker"
}
